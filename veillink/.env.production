# Public production build values for VeilLink (inlined into the client bundle).
# No secrets here: keys live in Cloudflare Worker secrets, and the Supabase anon
# key comes from veillink/.env or the environment. scripts/deploy-veillink-cloudflare.mjs
# passes these to `next build` as process env so a local .env/.env.local
# (often pointed at localhost) can never leak into a production build.
NEXT_PUBLIC_VEILLINK_APP_URL=https://app.veildaemon.app
NEXT_PUBLIC_VEILLINK_PATH_HOST=go.veildaemon.app
NEXT_PUBLIC_VEILLINK_BASE_DOMAIN=veildaemon.app
NEXT_PUBLIC_VEILLINK_PRODUCT_NAME=VeilLink
NEXT_PUBLIC_SUPABASE_URL=https://iaeykfeyctujqsqyenqt.supabase.co
