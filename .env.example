TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Main channel owner (numeric id). Final channel authority — not the bot login.
# VeilCorpNode
TWITCH_BROADCASTER_USER_ID=181850555
# SigilForge bot numeric id; grant this account Moderator on the main channel.
TWITCH_MODERATOR_USER_ID=1327200493
TWITCH_BOT_LOGIN=sigilforge
TWITCH_BOT_USER_ID=1327200493
# Bot user OAuth (VeilDaemon only — never commit; never send to VeilForge).
# Phase 1: chat:read. Phase 2: + chat:edit. Phase 3: mod write scopes only when enabled.
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
TWITCH_BOT_SCOPES=
TWITCH_REDIRECT_URI=http://localhost:3000/twitch/callback
TWITCH_AUTH_CODE=
TWITCH_EVENTSUB_SECRET=
TWITCH_EVENTSUB_CALLBACK=https://veildaemon.app/api/twitch/eventsub
# Forge stream-bridge (4F.1/4F.2) — local AF_UNIX only
VEIL_STREAM_BRIDGE_SOCKET=
VEIL_STREAM_BRIDGE_TOKEN=
VEIL_STREAM_BRIDGE_ENABLED=

# RelayDaemon remote local inference (phone -> hosted queue -> home daemon)
# Hosted Vercel project veildaemon-relay and the home bridge share these.
# The home daemon initiates outbound poll; do not expose Ollama, Forge, or 4174.
RELAY_REMOTE_URL=
RELAY_REMOTE_PAIRING_SECRET=
RELAY_DEVICE_ID=home-primary
RELAY_DEVICE_TOKEN=
RELAY_REMOTE_POLL_MS=2000
RELAY_REMOTE_REQUIRE_REDIS=

# Hosted RelayDaemon operator identity (VeilLink / Supabase).
# Browser Generate, /api/character, and /api/relay-remote/{whoami,status,submit,result}
# require a Knoxmortis VeilLink session. Device poll/complete stay on pairing tokens.
# Relay Vercel also needs the existing SUPABASE_URL / NEXT_PUBLIC_SUPABASE_* vars
# so /api/auth/config can hand VeilAuth a project URL and anon key.
RELAY_OPERATOR_EMAILS=j.donavon.love@gmail.com
RELAY_OPERATOR_HANDLES=knoxmortis
RELAY_OPERATOR_USER_IDS=

# Isolated VeilForge PR #23 adapter. Optional. Existing session UUID required.
# If unset, the local bridge fulfills remote character requests with Ollama.
VEILFORGE_SOCKET=
VEILFORGE_AUTH_TOKEN=
VEILFORGE_REMOTE_SESSION_ID=
VEILFORGE_REMOTE_TURN_ENABLED=
VEILFORGE_REMOTE_TURN_TIMEOUT_MS=120000

ALERT_ADMIN_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DISCORD_ROUTE_SECRET=
DISCORD_OPERATOR_DREAM_URL=
DISCORD_OPERATOR_SILENCE_URL=
DISCORD_OPERATOR_HUNGER_URL=
DISCORD_OPERATOR_STILLNESS_URL=
DISCORD_OPERATOR_EMPYREAN_URL=
DISCORD_OPERATOR_BECOMING_URL=
DISCORD_TRIAGE_DREAM_URL=
DISCORD_TRIAGE_SILENCE_URL=
DISCORD_TRIAGE_HUNGER_URL=
DISCORD_TRIAGE_STILLNESS_URL=
DISCORD_TRIAGE_EMPYREAN_URL=
DISCORD_TRIAGE_BECOMING_URL=
DISCORD_THREADBREAKER_URL=
STRIPE_SECRET_KEY=
BOOK_ONE_STRIPE_PRICE_ID=price_1TwE0oFht6uPr4mz4thEHLpN
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used only by `npm run push`/`ship` (scripts/unified-push.mjs) to apply
# supabase/migrations/ via `supabase db push`. Generate a token at
# https://supabase.com/dashboard/account/tokens. Project ref is the
# subdomain segment of the project's Supabase URL (also in config.toml
# once linked). Omit either to skip automated migrations (a warning
# prints and the push continues) and apply migrations by hand instead.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Optional. Only needed if `supabase db push` requires the direct Postgres
# password for your CLI version's connection mode.
SUPABASE_DB_PASSWORD=
BOOK_ONE_SUPABASE_BUCKET=paid-downloads
BOOK_ONE_SUPABASE_PATH=book-one/the-cradlepoint-archive-book-one-v47-2c-print-edition-verified.pdf
BOOK_ONE_WALLPAPER_PATH=book-one/book-one-wallpaper-pack.zip
BOOK_ONE_SIGNED_URL_TTL_SECONDS=900
