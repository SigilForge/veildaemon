# Used only by `npm run push`/`ship` (scripts/unified-push.mjs) to apply
# supabase/migrations/ via `supabase db push`. Generate a token at
# https://supabase.com/dashboard/account/tokens. Project ref is the
# subdomain segment of the project's Supabase URL (also in config.toml
# once linked). Omit either to skip automated migrations (a warning
# prints and the push continues) and apply migrations by hand instead.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Optional. Only needed if `supabase db push` requires the direct Postgres
# password for your CLI version's connection mode.
SUPABASE_DB_PASSWORD=
